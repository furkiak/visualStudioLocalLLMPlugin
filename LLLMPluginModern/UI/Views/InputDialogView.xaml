<controls:GlassWindow x:Class="LLLMPluginModern.UI.Views.InputDialogView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:LLLMPluginModern.UI.Controls"
                     xmlns:behaviors="clr-namespace:LLLMPluginModern.UI.Behaviors"
                     Title="{Binding Title}" Width="460" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel>
        <Grid Height="48" Margin="18,0">
            <controls:TrafficLights HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <StackPanel Margin="24,4,24,0">
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Hint}" FontSize="12.5" Margin="0,0,0,12"/>
            <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     behaviors:TextBoxHelper.Placeholder="Text to find"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,22,24,22">
            <Button Style="{StaticResource Button.Glass}" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Button.Primary}" Content="{Binding OkButtonText}" Command="{Binding OkCommand}" IsDefault="True" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</controls:GlassWindow>
