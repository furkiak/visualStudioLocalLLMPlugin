<Window x:Class="LLLMPluginModern.UI.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - AI Assistant" Height="455" Width="600"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="#E0E0E0" ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="AI Provider:" Foreground="#4DAAFB" FontWeight="Bold" FontSize="14" Margin="0,5" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding AiServer}" IsEnabled="{Binding IsNormalProfile}" Margin="0,5" FontSize="14" Padding="8" Background="#252526" Foreground="Black"/>

        <Label Grid.Row="1" Grid.Column="0" Content="URL:" Visibility="{Binding IsUrlVisible, Converter={StaticResource BoolToVis}}" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="14" Margin="0,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsValidationProfile}" Visibility="{Binding IsUrlVisible, Converter={StaticResource BoolToVis}}" Margin="0,5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Model:" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="14" Margin="0,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsNormalProfile, Converter={StaticResource BoolToVis}}" Margin="0,5"/>
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding FixtureScenarios}" SelectedItem="{Binding Model}" Visibility="{Binding IsValidationProfile, Converter={StaticResource BoolToVis}}" Margin="0,5" FontSize="14" Padding="8" Background="#252526" Foreground="Black" AutomationProperties.Name="Synthetic HTTP fixture scenario"/>

        <Label Grid.Row="3" Grid.Column="0" Content="API Key:" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="14" Margin="0,5" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="txtApiKey" IsEnabled="{Binding IsNormalProfile}" Margin="0,5" PasswordChanged="txtApiKey_PasswordChanged"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10">
            <TextBlock Text="{Binding ProfileNotice}" TextWrapping="Wrap" Foreground="#FFD1A8"/>
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="#FFD1A8" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,20,0,0">
            <Button Content="Save Settings" Command="{Binding SaveCommand}" Width="140" Height="40" Margin="0,0,15,0" Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Cancel" Command="{Binding CloseCommand}" Width="100" Height="40" Background="#3F3F46" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
