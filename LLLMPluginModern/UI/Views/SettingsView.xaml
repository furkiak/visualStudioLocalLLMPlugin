<controls:GlassWindow x:Class="LLLMPluginModern.UI.Views.SettingsView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:LLLMPluginModern.UI.Controls"
                     xmlns:behaviors="clr-namespace:LLLMPluginModern.UI.Behaviors"
                     xmlns:models="clr-namespace:LLLMPluginModern.Core.Models"
                     Title="Settings" Width="640" Height="760" MinWidth="560" MinHeight="520" ResizeMode="CanResize">

    <controls:GlassWindow.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </controls:GlassWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="18,0,18,0">
            <controls:TrafficLights HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <controls:Icon Data="{StaticResource Icon.Sliders}" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                <TextBlock Text="Settings" Style="{StaticResource Text.Title}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,14,0" Focusable="False">
            <StackPanel Margin="0,4,6,8">

                <!-- Provider -->
                <TextBlock Text="AI PROVIDER" Style="{StaticResource Text.Section}"/>
                <Border Style="{StaticResource Card}" Padding="16,16,16,6" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Provider" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" DisplayMemberPath="DisplayName"/>
                        </Grid>
                        <TextBlock Text="{Binding ProviderHint}" Style="{StaticResource Text.Hint}" Margin="120,-4,0,14"/>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Endpoint URL" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxHelper.Placeholder="Leave empty for the default endpoint"/>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API key" Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Column="1">
                                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged"/>
                                <TextBlock x:Name="ApiKeyPlaceholder" Text="{Binding ApiKeyPlaceholder}" Margin="13,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding AvailableModels}"
                                      Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="34" Height="34" Margin="8,0,0,0"
                                    Command="{Binding RefreshModelsCommand}" ToolTip="Load the models available on the server">
                                <controls:Icon Data="{StaticResource Icon.Refresh}"/>
                            </Button>
                        </Grid>

                        <Grid Margin="120,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Button.Glass}" Command="{Binding TestConnectionCommand}" Height="30" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource Icon.Plug}" Width="14" Height="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Test connection"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,6,0,0" VerticalAlignment="Top"
                                        Visibility="{Binding HasConnectionStatus, Converter={StaticResource Visible}}">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.TextTertiary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionOk}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionOk}" Value="False">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" FontSize="12" MaxWidth="330" Margin="0,-3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionOk}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Generation -->
                <TextBlock Text="GENERATION" Style="{StaticResource Text.Section}"/>
                <Border Style="{StaticResource Card}" Padding="16,16,16,6" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxHelper.Placeholder="Model default (recommended)"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max output tokens" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxHelper.Placeholder="Provider default"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Idle timeout (seconds)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Hint}" Margin="0,-2,0,10"
                                   Text="Temperature and token limits are stored per provider. Some newer models reject a custom temperature — leave it empty unless you need it."/>
                    </StackPanel>
                </Border>

                <!-- Assistant -->
                <TextBlock Text="ASSISTANT" Style="{StaticResource Text.Section}"/>
                <Border Style="{StaticResource Card}" Padding="16,14,16,14" Margin="0,0,0,20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Reset to default" Command="{Binding ResetSystemPromptCommand}"/>
                            <TextBlock Text="System prompt" Style="{StaticResource Text.Label}"/>
                        </DockPanel>
                        <TextBox Style="{StaticResource TextBox.Multiline}" Height="128" Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IncludeFileContext}">
                            <StackPanel>
                                <TextBlock Text="Send the whole file as context by default"/>
                                <TextBlock Text="Better answers for larger changes; uses more tokens." Style="{StaticResource Text.Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MatchIndentation}">
                            <StackPanel>
                                <TextBlock Text="Match indentation when applying code"/>
                                <TextBlock Text="Re-indents the answer to fit where it is inserted." Style="{StaticResource Text.Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowReasoning}">
                            <StackPanel>
                                <TextBlock Text="Show the model's thought process"/>
                                <TextBlock Text="For reasoning models (DeepSeek-R1, Qwen3, …) that expose their thinking." Style="{StaticResource Text.Hint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <TextBlock Text="APPEARANCE" Style="{StaticResource Text.Section}"/>
                <Border Style="{StaticResource Card}" Padding="16,14,16,14" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Capsule}}" Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.SurfaceRim}"
                                    BorderThickness="1" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Radio.Segment}" Content="Auto" GroupName="Theme" IsChecked="{Binding IsThemeAuto, Mode=OneWay}"
                                                 Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:ThemeModes.Auto}"/>
                                    <RadioButton Style="{StaticResource Radio.Segment}" Content="Dark" GroupName="Theme" IsChecked="{Binding IsThemeDark, Mode=OneWay}"
                                                 Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:ThemeModes.Dark}"/>
                                    <RadioButton Style="{StaticResource Radio.Segment}" Content="Light" GroupName="Theme" IsChecked="{Binding IsThemeLight, Mode=OneWay}"
                                                 Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:ThemeModes.Light}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Theme"/>
                                <TextBlock Text="Auto follows the Visual Studio color theme." Style="{StaticResource Text.Hint}"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Divider}" Margin="0,12"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseTranslucency}">
                            <StackPanel>
                                <TextBlock Text="Translucent glass (Windows 11)"/>
                                <TextBlock Text="Blurs the desktop behind the window. Applies the next time a window opens." Style="{StaticResource Text.Hint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Text.Hint}" Margin="6,8,0,0"
                           Text="API keys are encrypted with Windows DPAPI for your user account and never leave this machine except to call the provider you choose."/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="0,1,0,0" Padding="20,12,20,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Glass}" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
                    <Button Style="{StaticResource Button.Primary}" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasValidationError, Converter={StaticResource Visible}}">
                    <controls:Icon Data="{StaticResource Icon.Warning}" Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Danger}"/>
                    <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource Brush.DangerText}" FontSize="12" TextWrapping="Wrap" MaxWidth="360"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</controls:GlassWindow>
