<Window x:Class="LLLMPluginModern.UI.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="Settings · Local LLM tools" Height="760" Width="600" MinWidth="400" MinHeight="360"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" FontSize="{DynamicResource PluginBodyFontSize}"
        Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
        Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/LLLMPluginModern;component/UI/ThemeResources.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="BoolToVis"/></ResourceDictionary></Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="Settings" FontSize="{DynamicResource PluginHeadingFontSize}" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding ProfileNotice}" Margin="0,0,0,12"/>
            <TextBlock Text="AI provider" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding AiServer}" IsEnabled="{Binding IsNormalProfile}" Margin="0,0,0,16" AutomationProperties.Name="AI provider"/>
            <TextBlock Text="URL" Visibility="{Binding IsUrlVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsValidationProfile}" Visibility="{Binding IsUrlVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" AutomationProperties.Name="Provider URL"/>
            <TextBlock Text="Model" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsNormalProfile, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" AutomationProperties.Name="Model"/>
            <ComboBox ItemsSource="{Binding FixtureScenarios}" SelectedItem="{Binding Model}" Visibility="{Binding IsValidationProfile, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" AutomationProperties.Name="Synthetic HTTP fixture scenario"/>
            <TextBlock Text="API key" Margin="0,0,0,6"/>
            <PasswordBox x:Name="txtApiKey" IsEnabled="{Binding IsNormalProfile}" PasswordChanged="txtApiKey_PasswordChanged" Margin="0,0,0,16" AutomationProperties.Name="API key"/>
            <TextBlock Text="Text size" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding TextSizes}" SelectedItem="{Binding TextScalePercent}" Margin="0,0,0,12" AutomationProperties.Name="Text size">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}%}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Text size changes actual fonts throughout these dialogs. Colors follow the Visual Studio theme; surfaces are opaque. It does not change Windows display scaling or editor font preferences. Save stores the choice in this profile; Cancel leaves saved settings untouched." FontSize="{DynamicResource PluginCaptionFontSize}" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding ErrorText}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel>
                <Button Content="Save Settings" Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Command="{Binding CloseCommand}"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
