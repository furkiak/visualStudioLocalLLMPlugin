<controls:GlassWindow x:Class="LLLMPluginModern.UI.Views.MessageView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:LLLMPluginModern.UI.Controls"
                     Title="{Binding Title}" Width="420" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel>
        <Grid Height="44" Margin="18,0">
            <controls:TrafficLights HorizontalAlignment="Left"/>
        </Grid>

        <StackPanel Margin="32,0,32,0" HorizontalAlignment="Center">
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                <Ellipse x:Name="Halo" Fill="{DynamicResource Brush.AvatarFill}" Opacity="0.18"/>
                <controls:Icon x:Name="BadgeIcon" Data="{StaticResource Icon.Sparkles}" IsFilled="True" Width="34" Height="34"
                               Fill="{DynamicResource Brush.Intelligence}"/>
            </Grid>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" FontSize="17" HorizontalAlignment="Center" Margin="0,14,0,6"/>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5"
                       Foreground="{DynamicResource Brush.TextSecondary}" MaxWidth="340"/>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Hint}" TextAlignment="Center" Margin="0,12,0,0"
                       Visibility="{Binding Detail, Converter={StaticResource Visible}}"/>
            <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="Link_Click"
                    Visibility="{Binding HasLink, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding LinkText}"/>
            </Button>
        </StackPanel>

        <Button Style="{StaticResource Button.Primary}" Content="OK" Command="{Binding OkCommand}" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Stretch" Margin="32,22,32,24"/>
    </StackPanel>
</controls:GlassWindow>
