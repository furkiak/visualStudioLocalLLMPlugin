<controls:GlassWindow x:Class="LLLMPluginModern.UI.Views.ModifyReplicateView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:LLLMPluginModern.UI.Controls"
                     xmlns:behaviors="clr-namespace:LLLMPluginModern.UI.Behaviors"
                     Title="Modify &amp; Replicate" Width="500" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel>
        <Grid Height="48" Margin="18,0">
            <controls:TrafficLights HorizontalAlignment="Left"/>
            <TextBlock Text="Modify &amp; Replicate" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <StackPanel Margin="24,4,24,0">
            <TextBlock Style="{StaticResource Text.Hint}" FontSize="12.5" Margin="0,0,0,14"
                       Text="Every line that contains the target is duplicated once per replacement, with the target swapped for that replacement."/>

            <TextBlock Text="Target text" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
            <TextBox x:Name="TargetBox" Text="{Binding TargetWord, UpdateSourceTrigger=PropertyChanged}"
                     behaviors:TextBoxHelper.Placeholder="e.g. Name"/>

            <TextBlock Text="Replacements — one per line" Style="{StaticResource Text.Label}" Margin="0,16,0,6"/>
            <TextBox Style="{StaticResource TextBox.Multiline}" Height="150" Text="{Binding ReplacementWords, UpdateSourceTrigger=PropertyChanged}"
                     behaviors:TextBoxHelper.Placeholder="FirstName&#x0a;LastName&#x0a;Email"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,22,24,22">
            <Button Style="{StaticResource Button.Glass}" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Button.Primary}" Content="Replicate" Command="{Binding ApplyCommand}" MinWidth="110"/>
        </StackPanel>
    </StackPanel>
</controls:GlassWindow>
