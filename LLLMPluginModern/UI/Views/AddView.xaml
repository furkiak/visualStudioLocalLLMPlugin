<controls:GlassWindow x:Class="LLLMPluginModern.UI.Views.AddView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:LLLMPluginModern.UI.Controls"
                     xmlns:behaviors="clr-namespace:LLLMPluginModern.UI.Behaviors"
                     Title="Add to every line" Width="480" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel>
        <Grid Height="48" Margin="18,0">
            <controls:TrafficLights HorizontalAlignment="Left"/>
            <TextBlock Text="Add to every line" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <StackPanel Margin="24,4,24,0">
            <TextBlock Text="Text to add" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
            <TextBox x:Name="AddBox" Text="{Binding TextToAdd, UpdateSourceTrigger=PropertyChanged}"
                     behaviors:TextBoxHelper.Placeholder="e.g. // or ;"/>

            <TextBlock Text="Position" Style="{StaticResource Text.Label}" Margin="0,16,0,8"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Radio.Pill}" Content="Start of line" GroupName="Position" IsChecked="{Binding AtLineStart}"/>
                <RadioButton Style="{StaticResource Radio.Pill}" Content="End of line" GroupName="Position" IsChecked="{Binding AtLineEnd}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,22,24,22">
            <Button Style="{StaticResource Button.Glass}" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Button.Primary}" Content="Add" Command="{Binding ApplyCommand}" IsDefault="True" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</controls:GlassWindow>
