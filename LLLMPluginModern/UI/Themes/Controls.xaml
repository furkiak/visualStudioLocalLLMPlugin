                                        <DoubleAnimation Storyboard.TargetName="D2" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="D3" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
