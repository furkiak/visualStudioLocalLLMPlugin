<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<Extern href="stdidcmd.h"/>
	<Extern href="vsshlids.h"/>
	<Include href="KnownImageIds.vsct"/>

	<Commands package="guidLLLMPluginModernPackage">
		<Groups>
			<!-- Tools menu -->
			<Group guid="guidLLLMPluginModernPackageCmdSet" id="MyMenuGroup" priority="0x0600">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
			</Group>
			<!-- Code editor right-click menu -->
			<Group guid="guidLLLMPluginModernPackageCmdSet" id="EditorContextMenuGroup" priority="0x0100">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
			</Group>
		</Groups>

		<Buttons>
			<Button guid="guidLLLMPluginModernPackageCmdSet" id="Command1Id" priority="0x0100" type="Button">
				<Parent guid="guidLLLMPluginModernPackageCmdSet" id="MyMenuGroup" />
				<Icon guid="ImageCatalogGuid" id="MagicWand" />
				<CommandFlag>IconIsMoniker</CommandFlag>
				<Strings>
					<ButtonText>AI Assistant (Local LLM)</ButtonText>
					<CanonicalName>.Tools.AIAssistantLocalLLM</CanonicalName>
					<LocCanonicalName>.Tools.AIAssistantLocalLLM</LocCanonicalName>
				</Strings>
			</Button>
		</Buttons>
	</Commands>

	<CommandPlacements>
		<CommandPlacement guid="guidLLLMPluginModernPackageCmdSet" id="Command1Id" priority="0x0100">
			<Parent guid="guidLLLMPluginModernPackageCmdSet" id="EditorContextMenuGroup"/>
		</CommandPlacement>
	</CommandPlacements>

	<KeyBindings>
		<KeyBinding guid="guidLLLMPluginModernPackageCmdSet" id="Command1Id" editor="guidVSStd97" key1="1" mod1="Control" />
	</KeyBindings>

	<Symbols>
		<GuidSymbol name="guidLLLMPluginModernPackage" value="{769e069e-24ac-44f5-ab7c-6983dcc1e77a}" />

		<GuidSymbol name="guidLLLMPluginModernPackageCmdSet" value="{B51F9B79-13A2-4FA8-88D1-9BCCF6DE418D}">
			<IDSymbol name="MyMenuGroup" value="0x1020" />
			<IDSymbol name="EditorContextMenuGroup" value="0x1030" />
			<IDSymbol name="Command1Id" value="0x0100" />
		</GuidSymbol>
	</Symbols>
</CommandTable>
