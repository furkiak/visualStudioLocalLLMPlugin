<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Compile Include="../LLLMPluginModern/Infrastructure/Services/ResponseStream.cs" Link="Production/ResponseStream.cs" />
    <Compile Include="../LLLMPluginModern/Core/Models/*.cs" Link="Production/Models/%(Filename)%(Extension)" />
    <Compile Include="../LLLMPluginModern/Core/Interfaces/*.cs" Link="Production/Interfaces/%(Filename)%(Extension)" />
    <Compile Include="../LLLMPluginModern/Infrastructure/Services/*Service.cs" Exclude="../LLLMPluginModern/Infrastructure/Services/DialogService.cs" Link="Production/Services/%(Filename)%(Extension)" />
  <Compile Include="../LLLMPluginModern/UI/ViewModels/*.cs" Link="Production/ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../LLLMPluginModern/Infrastructure/Factories/LlmApiServiceFactory.cs" Link="Production/LlmApiServiceFactory.cs" />
    <Compile Include="../tools/LoopbackFixture/LoopbackOllamaFixture.cs" Link="Fixture/LoopbackOllamaFixture.cs" />
  </ItemGroup>
</Project>
